# Copy this file to ".env" and fill in your own values. Never commit ".env".

# ---- Server ----
NODE_ENV=development
PORT=5000
# Origin of the React dev server (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---- Authentication ----
# Secret used to sign login cookies. REQUIRED, at least 32 characters, keep it private.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Password hashing cost (bcrypt). 12 is a good default; higher is slower and stronger.
BCRYPT_COST=12

# ---- PostgreSQL (the server you connect to from pgAdmin 4) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libtrack
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# Set to true only if your server requires SSL (not needed for local installs)
DB_SSL=false

# ---- Connection pool ----
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ---- Optional: used only by "npm run db:create" ----
# A user allowed to create databases (for example "postgres").
# If omitted, DB_USER / DB_PASSWORD are used.
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=your_postgres_password
